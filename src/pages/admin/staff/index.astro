---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Staff Directory">
  <div class="mb-6 flex items-start justify-between flex-wrap gap-4">
    <div>
      <h1 class="text-2xl font-bold text-gray-800">Staff Directory</h1>
      <p class="text-gray-500 text-sm mt-1">Every employee by matricule, with the accounts they use on each platform (Admin, HR &amp; Payroll, Terrain, Sales) and their latest activity.</p>
    </div>
    <button id="auto-link" class="bg-[#194642] text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-[#2a5e59] disabled:opacity-60" title="Links each unlinked account to the employee with the same email">
      <i class="fas fa-link mr-1.5"></i> Auto-link by email
    </button>
  </div>

  <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4"><p class="text-xs text-gray-500 uppercase">Employees</p><p id="s-emp" class="text-2xl font-bold text-[#194642]">—</p></div>
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4"><p class="text-xs text-gray-500 uppercase">Active</p><p id="s-active" class="text-2xl font-bold text-green-600">—</p></div>
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4"><p class="text-xs text-gray-500 uppercase">Platform accounts</p><p id="s-acc" class="text-2xl font-bold text-blue-600">—</p></div>
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4"><p class="text-xs text-gray-500 uppercase">Linked to a matricule</p><p id="s-linked" class="text-2xl font-bold text-gray-800">—</p></div>
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4"><p class="text-xs text-gray-500 uppercase">Not linked</p><p id="s-unlinked" class="text-2xl font-bold text-amber-600">—</p></div>
  </div>

  <div id="notice" class="hidden mb-4 text-sm rounded-lg px-4 py-3"></div>

  <!-- Employees -->
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden mb-6">
    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between gap-3 flex-wrap">
      <h2 class="font-bold text-gray-800">Employees</h2>
      <input id="search" type="search" placeholder="Search matricule, name, job, email…" class="rounded-lg border-gray-300 text-sm w-full sm:w-72" />
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-xs text-gray-500 uppercase">
          <tr>
            <th class="px-4 py-3 text-left">Matricule</th>
            <th class="px-4 py-3 text-left">Employee</th>
            <th class="px-4 py-3 text-left">Status</th>
            <th class="px-4 py-3 text-left">Platforms</th>
            <th class="px-4 py-3 text-left">Latest activity</th>
            <th class="px-4 py-3 text-right"></th>
          </tr>
        </thead>
        <tbody id="emp-rows" class="divide-y divide-gray-50">
          <tr><td colspan="6" class="px-4 py-8 text-center text-gray-400">Loading…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Accounts -->
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between gap-3 flex-wrap">
      <div>
        <h2 class="font-bold text-gray-800">Platform accounts</h2>
        <p class="text-xs text-gray-500">Link each login to the employee it belongs to, so their actions carry the matricule.</p>
      </div>
      <label class="inline-flex items-center gap-2 text-sm text-gray-600"><input id="only-unlinked" type="checkbox" checked class="rounded border-gray-300 text-[#194642]" /> Only not linked</label>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-xs text-gray-500 uppercase">
          <tr>
            <th class="px-4 py-3 text-left">Account</th>
            <th class="px-4 py-3 text-left">Platform</th>
            <th class="px-4 py-3 text-left">Linked employee</th>
            <th class="px-4 py-3 text-left">Latest activity</th>
          </tr>
        </thead>
        <tbody id="acc-rows" class="divide-y divide-gray-50">
          <tr><td colspan="4" class="px-4 py-8 text-center text-gray-400">Loading…</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script>
  import { authFetch } from "../../../lib/supabase";
  import { readJsonSafe } from "../../../scripts/uploadHelpers";

  const esc = (v: unknown) => String(v ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!));
  const $ = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as T;
  const PLATFORM: Record<string, { label: string; cls: string }> = {
    admin: { label: "Admin", cls: "bg-[#194642]/10 text-[#194642]" },
    hr: { label: "HR & Payroll", cls: "bg-purple-100 text-purple-700" },
    terrain: { label: "Terrain", cls: "bg-amber-100 text-amber-700" },
    sales: { label: "Sales", cls: "bg-blue-100 text-blue-700" },
  };
  const STATUS: Record<string, string> = {
    active: "bg-green-100 text-green-700", on_leave: "bg-yellow-100 text-yellow-700",
    inactive: "bg-gray-100 text-gray-600", terminated: "bg-red-100 text-red-700",
  };
  const ago = (iso: string | null) => {
    if (!iso) return "—";
    const m = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
    if (m < 1) return "just now";
    if (m < 60) return `${m} min ago`;
    if (m < 1440) return `${Math.round(m / 60)} h ago`;
    return new Date(iso).toLocaleDateString();
  };

  let data: any = { employees: [], accounts: [] };

  function notice(msg: string, ok: boolean) {
    const el = $("notice");
    el.textContent = msg;
    el.className = `mb-4 text-sm rounded-lg px-4 py-3 ${ok ? "bg-green-50 text-green-700" : "bg-red-50 text-red-600"}`;
  }

  function badge(a: any) {
    const p = PLATFORM[a.account_type];
    return `<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full font-medium ${p.cls} ${a.active ? "" : "opacity-50 line-through"}" title="${esc(a.email || "")}">${esc(p.label)}${a.role ? ` · ${esc(a.role)}` : ""}</span>`;
  }

  function renderEmployees() {
    const q = $("search").value.trim().toLowerCase();
    const byEmp = new Map<string, any[]>();
    for (const a of data.accounts) if (a.employee_id) byEmp.set(a.employee_id, [...(byEmp.get(a.employee_id) || []), a]);

    const list = data.employees.filter((e: any) => !q ||
      [e.matricule, e.first_name, e.last_name, e.email, e.job_title, e.department, e.worker_id].some((v) => String(v || "").toLowerCase().includes(q)));

    $("emp-rows").innerHTML = list.length ? list.map((e: any) => {
      const accs = byEmp.get(e.id) || [];
      const latest = accs.filter((a) => a.last_activity_at).sort((a, b) => b.last_activity_at.localeCompare(a.last_activity_at))[0];
      return `
      <tr>
        <td class="px-4 py-3 font-mono text-xs font-semibold text-[#194642]">${esc(e.matricule)}</td>
        <td class="px-4 py-3">
          <p class="font-medium text-gray-800">${esc(e.first_name)} ${esc(e.last_name)}</p>
          <p class="text-xs text-gray-500">${esc(e.job_title || "")}${e.department ? " · " + esc(e.department) : ""}</p>
        </td>
        <td class="px-4 py-3"><span class="text-xs px-2 py-0.5 rounded-full font-medium ${STATUS[e.status] || STATUS.inactive}">${esc(String(e.status || "").replace(/_/g, " "))}</span></td>
        <td class="px-4 py-3"><div class="flex flex-wrap gap-1">${accs.length ? accs.map(badge).join("") : '<span class="text-xs text-gray-400">No platform account</span>'}</div></td>
        <td class="px-4 py-3 text-xs text-gray-500">${latest ? `${esc(latest.last_activity)}<br><span class="text-gray-400">${esc(ago(latest.last_activity_at))}</span>` : "—"}</td>
        <td class="px-4 py-3 text-right"><a href="/admin/activity/?employee_id=${encodeURIComponent(e.id)}" class="text-xs font-semibold text-[#194642] hover:underline whitespace-nowrap"><i class="fas fa-clock-rotate-left mr-1"></i>Activity</a></td>
      </tr>`;
    }).join("") : '<tr><td colspan="6" class="px-4 py-8 text-center text-gray-400">No employees match.</td></tr>';
  }

  function renderAccounts() {
    const only = $("only-unlinked").checked;
    const options = data.employees.map((e: any) => `<option value="${esc(e.id)}">${esc(e.matricule)} — ${esc(e.first_name)} ${esc(e.last_name)}</option>`).join("");
    const list = data.accounts.filter((a: any) => !only || !a.employee_id);
    $("acc-rows").innerHTML = list.length ? list.map((a: any) => `
      <tr data-type="${esc(a.account_type)}" data-id="${esc(a.id)}">
        <td class="px-4 py-3">
          <p class="font-medium text-gray-800">${esc(a.name || "—")}</p>
          <p class="text-xs text-gray-500">${esc(a.email || "")}</p>
        </td>
        <td class="px-4 py-3">${badge(a)}</td>
        <td class="px-4 py-3">
          <select class="link-select rounded-lg border-gray-300 text-xs w-64 max-w-full">
            <option value="">— Not linked —</option>${options}
          </select>
        </td>
        <td class="px-4 py-3 text-xs text-gray-500">${a.last_activity ? `${esc(a.last_activity)}<br><span class="text-gray-400">${esc(ago(a.last_activity_at))}</span>` : "—"}</td>
      </tr>`).join("") : `<tr><td colspan="4" class="px-4 py-8 text-center text-gray-400">${only ? "Every account is linked to an employee. ✓" : "No accounts."}</td></tr>`;
    // Set current values after rendering (avoids building `selected` into every option list).
    document.querySelectorAll<HTMLSelectElement>("#acc-rows .link-select").forEach((sel) => {
      const row = sel.closest("tr")!;
      const acc = data.accounts.find((x: any) => x.id === row.dataset.id && x.account_type === row.dataset.type);
      sel.value = acc?.employee_id || "";
      sel.dataset.prev = sel.value;
    });
  }

  async function load() {
    const res = await authFetch("/api/admin/staff-directory/");
    const json = await readJsonSafe(res);
    if (!res.ok) { notice(json.error || "Could not load the directory", false); return; }
    data = json;
    const s = json.stats || {};
    $("s-emp").textContent = String(s.employees ?? 0);
    $("s-active").textContent = String(s.active_employees ?? 0);
    $("s-acc").textContent = String(s.accounts ?? 0);
    $("s-linked").textContent = String(s.linked_accounts ?? 0);
    $("s-unlinked").textContent = String(s.unlinked_accounts ?? 0);
    renderEmployees();
    renderAccounts();
  }

  $("search").addEventListener("input", renderEmployees);
  $("only-unlinked").addEventListener("change", renderAccounts);

  $("acc-rows").addEventListener("change", async (e) => {
    const sel = e.target as HTMLSelectElement;
    if (!sel.classList.contains("link-select")) return;
    const row = sel.closest("tr")!;
    sel.disabled = true;
    const res = await authFetch("/api/admin/staff-directory/", {
      method: "PUT",
      body: JSON.stringify({ account_type: row.dataset.type, account_id: row.dataset.id, employee_id: sel.value || null }),
    });
    const out = await readJsonSafe(res);
    sel.disabled = false;
    if (!res.ok) { notice(out.error || "Could not update the link", false); sel.value = sel.dataset.prev || ""; return; }
    notice(sel.value ? "Account linked to the employee." : "Account unlinked.", true);
    await load();
  });

  $("auto-link").addEventListener("click", async () => {
    const btn = $<HTMLButtonElement>("auto-link");
    btn.disabled = true;
    const res = await authFetch("/api/admin/staff-directory/", { method: "POST", body: JSON.stringify({ action: "auto-link" }) });
    const out = await readJsonSafe(res);
    btn.disabled = false;
    if (!res.ok) { notice(out.error || "Auto-link failed", false); return; }
    notice(`Linked ${out.linked} account${out.linked === 1 ? "" : "s"} by matching email.${out.skipped?.length ? ` Skipped (employee already has an account on that platform): ${out.skipped.join(", ")}.` : ""}`, true);
    await load();
  });

  load();
</script>
