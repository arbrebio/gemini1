---
import HrLayout from "../../layouts/HrLayout.astro";
---

<HrLayout title="Change password">
  <div class="max-w-md mx-auto bg-white rounded-xl border border-gray-100 shadow-sm p-6 sm:p-8">
    <h2 class="text-lg font-bold text-gray-800">Choose a new password</h2>
    <p id="pw-intro" class="text-sm text-gray-500 mt-1">At least 10 characters, with letters and numbers.</p>

    <form id="pw-form" class="mt-6 space-y-4">
      <div>
        <label for="pw-current" class="block text-sm font-medium text-gray-700 mb-1">Current (temporary) password</label>
        <input id="pw-current" type="password" required autocomplete="current-password"
          class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#194642]" />
      </div>
      <div>
        <label for="pw-new" class="block text-sm font-medium text-gray-700 mb-1">New password</label>
        <input id="pw-new" type="password" required minlength="10" autocomplete="new-password"
          class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#194642]" />
      </div>
      <div>
        <label for="pw-new2" class="block text-sm font-medium text-gray-700 mb-1">Confirm new password</label>
        <input id="pw-new2" type="password" required minlength="10" autocomplete="new-password"
          class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#194642]" />
      </div>
      <button type="submit" id="pw-submit"
        class="w-full py-2.5 rounded-lg text-sm font-semibold text-white bg-[#194642] hover:bg-[#2a5e59] disabled:opacity-60">
        Update password
      </button>
      <p id="pw-status" class="hidden text-sm text-center rounded p-2" role="status"></p>
    </form>
  </div>
</HrLayout>

<script>
  import { supabase } from "../../lib/supabase";

  const form = document.getElementById("pw-form") as HTMLFormElement;
  const status = document.getElementById("pw-status")!;
  const submit = document.getElementById("pw-submit") as HTMLButtonElement;
  const say = (msg: string, ok: boolean) => {
    status.textContent = msg;
    status.className = `text-sm text-center rounded p-2 ${ok ? "bg-green-50 text-green-700" : "bg-red-50 text-red-600"}`;
  };

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const current = (document.getElementById("pw-current") as HTMLInputElement).value;
    const next = (document.getElementById("pw-new") as HTMLInputElement).value;
    const next2 = (document.getElementById("pw-new2") as HTMLInputElement).value;
    if (next !== next2) { say("The two new passwords do not match.", false); return; }
    if (next.length < 10 || !/[A-Za-z]/.test(next) || !/[0-9]/.test(next)) {
      say("Use at least 10 characters with letters and numbers.", false); return;
    }
    submit.disabled = true;
    try {
      const { data: { session } } = await supabase.auth.getSession();
      const res = await fetch("/api/hr/change-password/", {
        method: "POST",
        headers: { Authorization: `Bearer ${session?.access_token ?? ""}`, "Content-Type": "application/json" },
        body: JSON.stringify({ current_password: current, new_password: next }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || "Could not change the password");

      // The password change can invalidate the current token: sign in again.
      const email = session?.user?.email;
      if (email) await supabase.auth.signInWithPassword({ email, password: next });
      say("Password updated. Redirecting…", true);
      setTimeout(() => { window.location.href = "/hr/"; }, 900);
    } catch (err) {
      say(err instanceof Error ? err.message : "Could not change the password", false);
    } finally {
      submit.disabled = false;
    }
  });
</script>
