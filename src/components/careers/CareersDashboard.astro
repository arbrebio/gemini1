---
/**
 * Shared careers/HR panel — rendered by /admin/careers/… (AdminLayout) and by
 * the HR & Payroll portal /hr/… (HrLayout). `base` is the URL prefix for
 * links between panels.
 */
interface Props { base?: string }
const { base = '/admin/careers' } = Astro.props;

---

<div id="careers-root" data-base={base} class="contents">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-800">Careers Management</h1>
      <p class="text-gray-500 text-sm mt-1">Manage job postings, applications, and employees</p>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
      <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-1">Active Jobs</p>
      <p id="stat-jobs" class="text-3xl font-bold text-[#194642]">—</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
      <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-1">Total Applications</p>
      <p id="stat-apps" class="text-3xl font-bold text-blue-600">—</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
      <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-1">Pending Review</p>
      <p id="stat-pending" class="text-3xl font-bold text-yellow-500">—</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
      <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-1">Employees</p>
      <p id="stat-employees" class="text-3xl font-bold text-green-600">—</p>
    </div>
  </div>

  <!-- Quick Links -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <a href={`${base}/jobs/`} data-hr-area="recruitment" class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 hover:shadow-md transition-shadow group">
      <div class="flex items-center gap-4">
        <div class="bg-[#194642]/10 rounded-xl p-3">
          <i class="fas fa-briefcase text-[#194642] text-xl"></i>
        </div>
        <div>
          <h3 class="font-bold text-gray-800 group-hover:text-[#194642] transition-colors">Job Postings</h3>
          <p class="text-sm text-gray-500">Create and manage job listings</p>
        </div>
      </div>
    </a>
    <a href={`${base}/applications/`} data-hr-area="recruitment" class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 hover:shadow-md transition-shadow group">
      <div class="flex items-center gap-4">
        <div class="bg-blue-50 rounded-xl p-3">
          <i class="fas fa-file-alt text-blue-600 text-xl"></i>
        </div>
        <div>
          <h3 class="font-bold text-gray-800 group-hover:text-blue-600 transition-colors">Applications</h3>
          <p class="text-sm text-gray-500">Review and process applicants</p>
        </div>
      </div>
    </a>
    <a href={`${base}/employees/`} data-hr-area="employees" class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 hover:shadow-md transition-shadow group">
      <div class="flex items-center gap-4">
        <div class="bg-green-50 rounded-xl p-3">
          <i class="fas fa-id-card text-green-600 text-xl"></i>
        </div>
        <div>
          <h3 class="font-bold text-gray-800 group-hover:text-green-600 transition-colors">Employees</h3>
          <p class="text-sm text-gray-500">Manage employee records & IDs</p>
        </div>
      </div>
    </a>
    <a href={`${base}/payroll/`} data-hr-area="payroll" class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 hover:shadow-md transition-shadow group">
      <div class="flex items-center gap-4">
        <div class="bg-amber-50 rounded-xl p-3">
          <i class="fas fa-file-invoice-dollar text-amber-600 text-xl"></i>
        </div>
        <div>
          <h3 class="font-bold text-gray-800 group-hover:text-amber-600 transition-colors">Payroll</h3>
          <p class="text-sm text-gray-500">Generate bulletins de paie</p>
        </div>
      </div>
    </a>
  </div>

  <!-- Recent Applications -->
  <div data-hr-area="recruitment" class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
      <h2 class="font-bold text-gray-800">Recent Applications</h2>
      <a href={`${base}/applications/`} class="text-sm text-[#194642] hover:underline">View all</a>
    </div>
    <div id="recent-apps" class="divide-y divide-gray-50">
      <div class="px-6 py-8 text-center text-gray-400 text-sm">Loading...</div>
    </div>
  </div>
</div>
<script>
  import { authFetch } from "../../lib/supabase";

  // Same panel serves /admin/careers/… and the HR portal /hr/…
  const CAREERS_BASE = document.getElementById('careers-root')?.dataset.base || '/admin/careers';

  function esc(v: unknown) { return String(v ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
  const statusColors: Record<string, string> = {
    submitted: 'bg-blue-100 text-blue-700',
    under_review: 'bg-yellow-100 text-yellow-700',
    interview_scheduled: 'bg-purple-100 text-purple-700',
    interview_done: 'bg-indigo-100 text-indigo-700',
    offer_sent: 'bg-orange-100 text-orange-700',
    hired: 'bg-green-100 text-green-700',
    rejected: 'bg-red-100 text-red-700',
    withdrawn: 'bg-gray-100 text-gray-700',
  };

  async function loadDashboard() {
    try {
      const [jobsRes, appsRes, empsRes] = await Promise.all([
        authFetch('/api/admin/careers/jobs/'),
        authFetch('/api/admin/careers/applications/'),
        authFetch('/api/admin/careers/employees/'),
      ]);
      // HR staff may hold only some areas: a refused request leaves "—".
      const read = async (r: Response) => (r.ok ? r.json().catch(() => null) : null);
      const [jobsData, appsData, empsData] = await Promise.all([read(jobsRes), read(appsRes), read(empsRes)]);

      const jobs = jobsData?.jobs || [];
      const apps = appsData?.applications || [];
      const emps = empsData?.employees || [];

      const set = (id: string, v: string) => { document.getElementById(id)!.textContent = v; };
      if (jobsData) set('stat-jobs', String(jobs.filter((j: any) => j.status === 'published').length));
      if (appsData) {
        set('stat-apps', String(apps.length));
        set('stat-pending', String(apps.filter((a: any) => a.status === 'submitted').length));
      }
      if (empsData) set('stat-employees', String(emps.length));

      const recent = apps.slice(0, 8);
      const container = document.getElementById('recent-apps')!;
      if (!recent.length) {
        container.innerHTML = '<div class="px-6 py-8 text-center text-gray-400 text-sm">No applications yet.</div>';
        return;
      }
      container.innerHTML = recent.map((a: any) => `
        <a href="${CAREERS_BASE}/applications/?id=${encodeURIComponent(a.id)}" class="flex items-center justify-between px-6 py-4 hover:bg-gray-50 transition-colors">
          <div>
            <p class="font-medium text-gray-800">${esc(a.first_name)} ${esc(a.last_name)}</p>
            <p class="text-sm text-gray-500">${esc(a.career_jobs?.title_en) || 'Unknown job'} · ${esc(a.email)}</p>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-xs px-2.5 py-1 rounded-full font-medium ${statusColors[a.status] || 'bg-gray-100 text-gray-600'}">${esc(String(a.status || '').replace(/_/g,' '))}</span>
            <span class="text-xs text-gray-400">${new Date(a.submitted_at).toLocaleDateString()}</span>
          </div>
        </a>
      `).join('');
    } catch (e) {
      console.error('Dashboard load error:', e);
    }
  }

  loadDashboard();
</script>
