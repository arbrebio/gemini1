---
import { getImageEntry, getWebPSrcSet } from '../lib/imageOptimization';

interface Props {
  src: string;
  alt: string;
  width?: number | string;
  height?: number | string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'sync' | 'auto';
  /** sizes attribute for the WebP source, e.g. "(min-width: 1024px) 50vw, 100vw" */
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  fetchpriority,
  decoding = 'async',
  sizes = '100vw',
  class: className
} = Astro.props;

// Images generated by scripts/generate-image-variants.mjs get a <picture>
// with a WebP srcset; anything else falls back to a plain <img>.
const entry = getImageEntry(src);
const srcset = entry ? getWebPSrcSet(src, entry) : undefined;
const intrinsicWidth = width ?? entry?.width;
const intrinsicHeight = height ?? entry?.height;
---

{entry ? (
  <picture>
    <source srcset={srcset} sizes={sizes} type="image/webp" />
    <img
      src={src}
      alt={alt}
      width={intrinsicWidth}
      height={intrinsicHeight}
      loading={loading}
      fetchpriority={fetchpriority}
      class={className}
      decoding={decoding}
    />
  </picture>
) : (
  <img
    src={src}
    alt={alt}
    width={intrinsicWidth}
    height={intrinsicHeight}
    loading={loading}
    fetchpriority={fetchpriority}
    class={className}
    decoding={decoding}
  />
)}
