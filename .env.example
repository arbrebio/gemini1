# Environment variables for the Arbre Bio website.
# Copy to .env for local development; set the same names in Vercel for production.
# Only variables the code actually reads are listed here.

# ── Supabase (supabase.com > Project Settings > API) ─────────────────────────
PUBLIC_SUPABASE_URL=your_supabase_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. Bypasses row-level security — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Admin access ─────────────────────────────────────────────────────────────
# Fallback allowlist used ONLY if the admin_profiles table does not exist.
# Comma-separated. Leave empty when admin_profiles is in place.
ADMIN_EMAILS=

# ── E-mail (resend.com > API Keys) ───────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key

# ── Newsletter ───────────────────────────────────────────────────────────────
# Optional. Signs unsubscribe links; falls back to the service-role key.
# Generate with: openssl rand -hex 32
NEWSLETTER_UNSUBSCRIBE_SECRET=

# ── Cloudflare Turnstile (dash.cloudflare.com > Turnstile) ───────────────────
# Protects the contact, quote, newsletter and job-application forms.
# In production a missing secret REJECTS submissions (fails closed).
PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ── WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp) ───────
# Optional. Without these, WhatsApp notifications are skipped.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Anthropic (console.anthropic.com > API Keys) ─────────────────────────────
# Optional. Used by the admin ID-card scanner.
ANTHROPIC_API_KEY=

# ── Site ─────────────────────────────────────────────────────────────────────
SITE=https://www.arbrebio.com

# ── SEO / analytics (all optional) ───────────────────────────────────────────
# Google Search Console > Settings > Ownership verification > HTML tag ("content" value only)
PUBLIC_GSC_VERIFICATION=
# Google Analytics > Admin > Data Streams > Measurement ID
PUBLIC_GA_MEASUREMENT_ID=
# Meta Events Manager > your pixel (ID shown at top)
PUBLIC_META_PIXEL_ID=
# Meta Events Manager > your pixel > Settings > Conversions API > Generate access token
META_CAPI_ACCESS_TOKEN=
# Meta Business Manager > Brand Safety > Domains > Add a meta-tag ("content" value only)
PUBLIC_FB_DOMAIN_VERIFICATION=
